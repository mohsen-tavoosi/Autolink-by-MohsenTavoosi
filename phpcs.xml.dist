<?xml version="1.0"?>
<ruleset name="Autolink by MohsenTavoosi">
	<description>WordPress Coding Standards for the plugin.</description>
	<file>autolink-by-mohsentavoosi</file>
	<arg name="extensions" value="php"/>
	<rule ref="WordPress-Extra">
		<exclude name="WordPress.Files.FileName"/>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array"><element value="autolink-by-mohsentavoosi"/></property>
		</properties>
	</rule>
	<config name="testVersion" value="7.4-"/>
</ruleset>
